# ==========================================
# XAALISI PRODUCTION ENVIRONMENT VARIABLES
# ==========================================
# Instructions:
# 1. Copiez ce fichier en le nommant `.env` sur votre serveur Azure.
# 2. Modifiez les mots de passe et les clés secrètes avec vos propres valeurs.

# --- Database Configurations ---
POSTGRES_USER=xaalisi_admin
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=xaalisi_prod

# --- Backend Security ---
# Générez une clé secrète forte (ex: avec `openssl rand -hex 32`)
SECRET_KEY=your_very_long_and_secure_jwt_secret_key_here
ENVIRONMENT=production

# --- Observability Stack ---
GF_SECURITY_ADMIN_PASSWORD=your_strong_grafana_password_here

# --- Orange Money API Integration ---
OM_API_KEY=your_real_orange_money_api_key
OM_SECRET_KEY=your_real_orange_money_secret_key
